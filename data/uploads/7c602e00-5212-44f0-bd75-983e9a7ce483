const http = require("http");
const fs = require("fs");
const path = require("path");
const crypto = require("crypto");

const HOST = "0.0.0.0";
const PORT = Number(process.env.PORT || 8848);
const PUBLIC_DIR = path.join(__dirname, "public");
const DATA_DIR = path.join(__dirname, "data");
const HISTORY_FILE = path.join(DATA_DIR, "messages.json");
const MAX_HISTORY = 150;
const MAX_MESSAGE_LENGTH = 2000;
const MAX_BODY = 8192;
const CLIENT_TIMEOUT_MS = 15000;

fs.mkdirSync(DATA_DIR, { recursive: true });

function loadHistory() {
  try {
    const data = JSON.parse(fs.readFileSync(HISTORY_FILE, "utf8"));
    return Array.isArray(data) ? data.slice(-MAX_HISTORY) : [];
  } catch {
    return [];
  }
}
let history = loadHistory();
let saveQueue = Promise.resolve();
const clients = new Map();
const sendTimes = new Map();

function saveHistory() {
  const snapshot = JSON.stringify(history, null, 2);
  saveQueue = saveQueue
    .then(() => fs.promises.writeFile(HISTORY_FILE, snapshot, "utf8"))
    .catch((err) => console.error("History save failed:", err.message));
}

function cleanName(value) {
  return typeof value === "string" ? value.trim().replace(/\s+/g, " ").slice(0, 24) : "";
}
function cleanText(value) {
  return typeof value === "string" ? value.trim().slice(0, MAX_MESSAGE_LENGTH) : "";
}
function json(res, status, value) {
  const body = JSON.stringify(value);
  res.writeHead(status, {
    "Content-Type": "application/json; charset=utf-8",
    "Content-Length": Buffer.byteLength(body),
    "Cache-Control": "no-store",
    "X-Content-Type-Options": "nosniff"
  });
  res.end(body);
}
function readBody(req) {
  return new Promise((resolve, reject) => {
    let raw = "";
    req.on("data", chunk => {
      raw += chunk;
      if (Buffer.byteLength(raw) > MAX_BODY) {
        reject(new Error("Request too large"));
        req.destroy();
      }
    });
    req.on("end", () => {
      try { resolve(raw ? JSON.parse(raw) : {}); }
      catch { reject(new Error("Invalid JSON")); }
    });
    req.on("error", reject);
  });
}
function pruneClients() {
  const cutoff = Date.now() - CLIENT_TIMEOUT_MS;
  for (const [id, client] of clients) {
    if (client.lastSeen < cutoff) {
      clients.delete(id);
      sendTimes.delete(id);
    }
  }
}
function addSystemMessage(text) {
  const message = { id: crypto.randomUUID(), name: "Delta LAN", text, time: new Date().toISOString(), system: true };
  history.push(message);
  if (history.length > MAX_HISTORY) history = history.slice(-MAX_HISTORY);
  saveHistory();
}
function contentType(file) {
  const ext = path.extname(file).toLowerCase();
  return ({
    ".html": "text/html; charset=utf-8",
    ".css": "text/css; charset=utf-8",
    ".js": "text/javascript; charset=utf-8",
    ".json": "application/json; charset=utf-8",
    ".svg": "image/svg+xml"
  })[ext] || "application/octet-stream";
}
async function handle(req, res) {
  const url = new URL(req.url, `http://${req.headers.host || "localhost"}`);
  if (req.method === "GET" && url.pathname === "/health") {
    return json(res, 200, { ok: true, service: "Delta LAN Messenger" });
  }

  if (req.method === "POST" && url.pathname === "/api/join") {
    let body;
    try { body = await readBody(req); } catch (e) { return json(res, 400, { error: e.message }); }
    const id = typeof body.clientId === "string" ? body.clientId.slice(0, 80) : "";
    const name = cleanName(body.name);
    if (!id || !name) return json(res, 400, { error: "Enter a valid display name." });
    pruneClients();
    const existed = clients.has(id);
    clients.set(id, { name, lastSeen: Date.now() });
    if (!existed) addSystemMessage(`${name} joined the LAN chat`);
    return json(res, 200, { ok: true, name });
  }

  if (req.method === "POST" && url.pathname === "/api/heartbeat") {
    let body;
    try { body = await readBody(req); } catch (e) { return json(res, 400, { error: e.message }); }
    const client = clients.get(String(body.clientId || ""));
    if (!client) return json(res, 401, { error: "Join the chat again." });
    client.lastSeen = Date.now();
    return json(res, 200, { ok: true });
  }

  if (req.method === "GET" && url.pathname === "/api/state") {
    pruneClients();
    return json(res, 200, {
      messages: history,
      users: [...clients.values()].map(c => c.name)
    });
  }

  if (req.method === "POST" && url.pathname === "/api/messages") {
    let body;
    try { body = await readBody(req); } catch (e) { return json(res, 400, { error: e.message }); }
    const id = String(body.clientId || "");
    const client = clients.get(id);
    if (!client) return json(res, 401, { error: "Join the chat before sending messages." });
    const text = cleanText(body.text);
    if (!text) return json(res, 400, { error: "Message is empty." });
    const now = Date.now();
    const recent = (sendTimes.get(id) || []).filter(t => now - t < 5000);
    if (recent.length >= 8) return json(res, 429, { error: "Please wait a moment before sending more messages." });
    recent.push(now);
    sendTimes.set(id, recent);
    const message = { id: crypto.randomUUID(), name: client.name, text, time: new Date(now).toISOString() };
    history.push(message);
    if (history.length > MAX_HISTORY) history = history.slice(-MAX_HISTORY);
    saveHistory();
    client.lastSeen = now;
    return json(res, 200, { ok: true, message });
  }

  if (req.method === "GET") {
    const requested = url.pathname === "/" ? "index.html" : decodeURIComponent(url.pathname.slice(1));
    const file = path.resolve(PUBLIC_DIR, requested);
    if (!file.startsWith(PUBLIC_DIR + path.sep) && file !== path.join(PUBLIC_DIR, "index.html")) {
      return json(res, 403, { error: "Forbidden" });
    }
    fs.readFile(file, (err, data) => {
      if (err) return json(res, 404, { error: "Not found" });
      res.writeHead(200, {
        "Content-Type": contentType(file),
        "Cache-Control": "no-cache",
        "X-Content-Type-Options": "nosniff"
      });
      res.end(data);
    });
    return;
  }

  json(res, 404, { error: "Not found" });
}

const server = http.createServer((req, res) => {
  handle(req, res).catch(err => {
    console.error(err);
    if (!res.headersSent) json(res, 500, { error: "Server error" });
    else res.end();
  });
});
server.listen(PORT, HOST, () => {
  console.log("Delta LAN Messenger is running.");
  console.log(`Ubuntu local URL: http://127.0.0.1:${PORT}`);
  console.log(`Windows LAN URL:  http://192.168.101.50:${PORT}`);
  console.log("No npm packages or internet connection are required.");
  console.log("Press Ctrl+C to stop.");
});
